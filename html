<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz TONALIA interior design </title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background: #f4f4f9; }
    .quiz-container { background: white; padding: 20px; border-radius: 8px; max-width: 500px; margin: auto; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
    .option-btn { display: block; width: 100%; padding: 10px; margin: 8px 0; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; text-align: left; }
    .option-btn:hover { background: #0056b3; }
    #result { margin-top: 20px; font-weight: bold; font-size: 1.2em; }
  </style>
</head>
<body>

  <div class="quiz-container">
    <h2 id="question">Caricamento domanda...</h2>
    <div id="options"></div>
    <div id="result"></div>
  </div>

  <script src="script.js"></script>
</body>
</html>
